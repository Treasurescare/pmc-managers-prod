# Elastic Beanstalk v2 single-container platform file.
# Used when EB runs the "Docker running on 64bit Amazon Linux" platform.
# The Image section points at the local Dockerfile so EB builds the image
# from source on each deploy.
{
  "AWSEBDockerrunVersion": "1",
  "Image": {
    "Name": "local"
  },
  "Ports": [
    {
      "ContainerPort": "8001",
      "HostPort": "80"
    }
  ]
}
