# Dump environment variable NAMES (not values!) on container startup so
# we can confirm from EB logs that MONGO_URL, JWT_SECRET, etc. actually
# reached the container. Runs once at build time via Docker; the actual
# dump happens inside server.py's startup event.
option_settings:
  aws:elasticbeanstalk:application:environment:
    PMC_LOG_ENV_KEYS_ON_BOOT: "1"
