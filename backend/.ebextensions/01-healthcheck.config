# EB Docker single-container (AL2023): make nginx forward the Enhanced
# Health request path "/" directly to the container's EXPOSEd port so the
# ALB sees 200 instead of 404 while the master-data bootstrap is still
# running. (server.py already registers "/" and "/health" probes.)
option_settings:
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /health
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /health
    MatcherHTTPCode: "200"
    Port: "80"
    Protocol: HTTP
