# Pin environment to a single instance so a bad auto-scaled sibling can
# never dilute the healthy one into a 50 % 5xx mix. Scale up again later
# via EB Console → Configuration → Capacity.
option_settings:
  aws:autoscaling:asg:
    MinSize: "1"
    MaxSize: "1"
  aws:elasticbeanstalk:environment:
    EnvironmentType: SingleInstance
